{
  "expo": {
    "name": "Yard Tracker",
    "slug": "yard-tracker",
    "version": "1.3.2",
    "icon": "./assets/stw-app-icon.png",
    "android": {
      "package": "com.yardtracker.mobile",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/stw-app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/stw-launch-logo.jpg",
          "imageWidth": 330,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yard Tracker to scan container and location barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Yard Tracker to record the yard location for each action."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
